{
  "name": "vibe-ide",
  "version": "0.10.8",
  "author": "luguan",
  "license": "MIT",
  "description": "A vibe coding IDE with terminal session management, native terminal, and git management",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/patch-dsh-base.mjs",
    "typecheck": "tsc -b",
    "preview": "electron-vite preview",
    "test": "node --test --test-reporter=spec test/**/*.test.mjs",
    "test:perf": "node test/perf-file-switch.mjs",
    "start": "electron-vite preview",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npx electron-builder --win --x64"
  },
  "build": {
    "appId": "com.vibe-ide",
    "productName": "Vibe IDE",
    "copyright": "Copyright © 2026 luguan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-gfm/**",
      "!node_modules/lucide-react/**",
      "!node_modules/dagre/**",
      "!node_modules/@types/dagre/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/computer-use-mcp.js",
        "to": "computer-use-mcp.js"
      }
    ],
    "extraFiles": [
      {
        "from": "snippets",
        "to": "snippets",
        "filter": [
          "*.css",
          "*.jpg",
          "*.jpeg",
          "*.png",
          "*.svg",
          "*.gif",
          "*.webp",
          "*.bmp",
          "assets/**",
          "snippets.json"
        ]
      },
      {
        "from": "pets",
        "to": "pets",
        "filter": [
          "**/*.webp",
          "**/*.png",
          "**/*.json"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        "nsis",
        "7z"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "Vibe IDE",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ]
    },
    "afterPack": "./scripts/afterPack.js",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "file:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "file:../deepseek-harness/vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "file:../deepseek-harness/vendor/loader",
    "@deepseek-ai/cosmokit": "file:../deepseek-harness/vendor/cosmokit",
    "@deepseek-ai/dsh-agent": "file:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-default-model": "file:../deepseek-harness/packages/core/agent-default-model",
    "@deepseek-ai/dsh-agent-presets": "file:../deepseek-harness/packages/preset/agent-presets",
    "@deepseek-ai/dsh-api-gateway": "file:../deepseek-harness/packages/api/gateway",
    "@deepseek-ai/dsh-api-remotes": "file:../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-atomic-write": "file:../deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-attachment": "file:../deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-brand": "file:../deepseek-harness/packages/util/brand",
    "@deepseek-ai/dsh-client-connection": "file:../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "file:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "file:../deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-schema-form": "file:../deepseek-harness/packages/client/schema-form",
    "@deepseek-ai/dsh-client-ui-agent-preset": "file:../deepseek-harness/packages/client/ui-agent-preset",
    "@deepseek-ai/dsh-client-ui-attachment": "file:../deepseek-harness/packages/client/ui-attachment",
    "@deepseek-ai/dsh-client-ui-commands": "file:../deepseek-harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-input-trigger": "file:../deepseek-harness/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-layout": "file:../deepseek-harness/packages/client/ui-layout",
