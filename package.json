{
  "name": "vibe-ide",
  "version": "0.13.3",
  "author": "luguan",
  "license": "MIT",
  "description": "A vibe coding IDE with terminal session management, native terminal, and git management",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "preview": "electron-vite preview",
    "test": "node --test --test-reporter=spec test/**/*.test.mjs",
    "test:perf": "node test/perf-file-switch.mjs",
    "start": "electron-vite preview",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npx electron-builder --win --x64",
    "build:win:7z": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npx electron-builder --win 7z --x64"
  },
  "build": {
    "appId": "com.vibe-ide",
    "productName": "Vibe IDE",
    "copyright": "Copyright © 2026 luguan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-gfm/**",
      "!node_modules/lucide-react/**",
      "!node_modules/dagre/**",
      "!node_modules/@types/dagre/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/computer-use-mcp.js",
        "to": "computer-use-mcp.js"
      },
      {
        "from": "resources/browser-mcp.js",
        "to": "browser-mcp.js"
      }
    ],
    "extraFiles": [
      {
        "from": "snippets",
        "to": "snippets",
        "filter": [
          "*.css",
          "*.jpg",
          "*.jpeg",
          "*.png",
          "*.svg",
          "*.gif",
          "*.webp",
          "*.bmp",
          "assets/**"
        ]
      },
      {
        "from": "pets",
        "to": "pets",
        "filter": [
          "**/*.webp",
          "**/*.png",
          "**/*.json"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        "nsis",
        "7z"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "Vibe IDE",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ]
    },
    "afterPack": "./scripts/afterPack.js",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/pyright/**",
      "node_modules/typescript/**",
      "node_modules/typescript-language-server/**"
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/dagre": "^0.7.54",
    "@xterm/addon-clipboard": "^0.3.0-beta.290",
    "@xterm/addon-fit": "^0.12.0-beta.290",
    "@xterm/addon-search": "^0.17.0-beta.290",
    "@xterm/addon-unicode-graphemes": "^0.5.0-beta.290",
    "@xterm/addon-web-links": "^0.13.0-beta.290",
    "@xterm/addon-webgl": "^0.20.0-beta.289",
    "@xterm/xterm": "^6.1.0-beta.290",
    "dagre": "^0.8.5",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "pyright": "^1.1.414",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "simple-git": "^3.27.0",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-language-server": "5.1.1",
    "unified": "^11.0.5",
    "@standard-schema/spec": "^1.1.0",
    "js-yaml": "^4.2.0",
    "zod": "^4.4.3",
    "commander": "^15.0.0",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1",
    "immer": "^10.2.0",
    "zustand": "^4.4.7",
    "ws": "^8.21.0",
    "fflate": "^0.8.3",
    "koffi": "^3.1.1",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0",
    "use-sync-external-store": "^1.2.0",
    "@babel/code-frame": "^7.29.7",
    "chokidar": "^4.0.3",
    "picomatch": "^4.0.4",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4",
    "@vscode/ripgrep": "^1.18.0",
    "yaml": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@earendil-works/pi-ai": "^0.82.1",
    "eventsource-parser": "^3.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "resedit": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
