    "@deepseek-ai/dsh-client-ui-settings-general": "file:../deepseek-harness/packages/client/ui-settings-general",
    "@deepseek-ai/dsh-client-ui-settings-models": "file:../deepseek-harness/packages/client/ui-settings-models",
    "@deepseek-ai/dsh-client-ui-settings-plugin-inventory": "file:../deepseek-harness/packages/client/ui-settings-plugin-inventory",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "file:../deepseek-harness/packages/client/ui-settings-plugins",
