{
  "name": "vibe-ide",
  "version": "0.8.4",
  "author": "luguan",
  "license": "MIT",
  "description": "A vibe coding IDE with terminal session management, native terminal, and git management",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "preview": "electron-vite preview",
    "test": "node --test --test-reporter=spec test/**/*.test.mjs",
    "test:perf": "node test/perf-file-switch.mjs",
    "start": "electron-vite preview",
    "build:win": "npm run build && cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ npx electron-builder --win --x64"
  },
  "build": {
    "appId": "com.vibe-ide",
    "productName": "Vibe IDE",
    "copyright": "Copyright © 2026 luguan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-gfm/**",
      "!node_modules/lucide-react/**",
      "!node_modules/dagre/**",
      "!node_modules/@types/dagre/**"
    ],
    "extraFiles": [
      {
        "from": "snippets",
        "to": "snippets",
        "filter": [
          "*.css"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        "nsis",
        "7z"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "Vibe IDE",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ]
    },
    "afterPack": "./scripts/afterPack.js",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/dagre": "^0.7.54",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "latest",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "latest",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dagre": "^0.8.5",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.469.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.27.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "resedit": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
