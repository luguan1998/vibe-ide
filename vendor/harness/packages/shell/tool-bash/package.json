{
  "name": "@deepseek-ai/dsh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-shell": "file:shell",
    "@deepseek-ai/dsh-shell-env": "file:shell-env",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-sandbox": "file:../sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../sandbox/sandbox-policy",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-jobs": "file:../jobs/jobs",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/dsh-user-approval": "file:../interaction/user-approval",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../../vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../core/agent-loop",
    "@deepseek-ai/dsh-shell": "file:shell",
    "@deepseek-ai/dsh-shell-env": "file:shell-env",
    "@deepseek-ai/dsh-bash-local": "file:bash-local",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-subprocess-local": "file:../subprocess/subprocess-local",
    "@deepseek-ai/dsh-sandbox": "file:../sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../sandbox/sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-session-persistence-jsonl": "file:../session/session-persistence-jsonl",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-jobs": "file:../jobs/jobs",
    "@deepseek-ai/dsh-jobs-local": "file:../jobs/jobs-local",
    "@deepseek-ai/dsh-tool-jobs": "file:../jobs/tool-jobs",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/dsh-user-approval": "file:../interaction/user-approval",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
