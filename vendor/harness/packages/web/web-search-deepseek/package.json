{
  "name": "@deepseek-ai/dsh-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-credentials": "file:../credentials/credentials",
    "@deepseek-ai/dsh-launch-environment": "file:../util/launch-environment",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-web": "file:web",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "@deepseek-ai/dsh-settings": "file:../settings/settings"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../../vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-credentials": "file:../credentials/credentials",
    "@deepseek-ai/dsh-credentials-local": "file:../credentials/credentials-local",
    "@deepseek-ai/dsh-launch-environment": "file:../util/launch-environment",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-web": "file:web",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "@deepseek-ai/dsh-settings": "file:../settings/settings"
  }
}
