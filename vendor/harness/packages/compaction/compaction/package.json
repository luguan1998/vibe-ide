{
  "name": "@deepseek-ai/dsh-compaction",
  "description": "Abstract compaction service seam (ctx.compaction) for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/compaction/compaction"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./checkpoint": {
      "types": "./lib/types/checkpoint.d.ts",
      "default": "./lib/types/checkpoint.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "file:../util/brand",
    "@deepseek-ai/dsh-commands": "file:../interaction/commands",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "file:../util/brand",
    "@deepseek-ai/dsh-commands": "file:../interaction/commands",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
