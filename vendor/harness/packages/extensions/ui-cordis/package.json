{
  "name": "@deepseek-ai/dsh-client-ui-cordis",
  "description": "Cordis dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/ui-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "file:../api/remotes",
    "@deepseek-ai/dsh-client-connection": "file:../client/connection",
    "@deepseek-ai/dsh-cordis-client-runner": "file:cordis-client-runner",
    "@deepseek-ai/dsh-client-locale": "file:../client/locale",
    "@deepseek-ai/dsh-client-runtime": "file:../client/runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "file:../client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:../client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-input-trigger": "file:../client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-slots": "file:../client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "file:../client/ui-tool",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "file:../api/remotes",
    "@deepseek-ai/dsh-client-connection": "file:../client/connection",
    "@deepseek-ai/dsh-cordis-client-runner": "file:cordis-client-runner",
    "@deepseek-ai/dsh-client-locale": "file:../client/locale",
    "@deepseek-ai/dsh-client-runtime": "file:../client/runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "file:../client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:../client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-input-trigger": "file:../client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-slots": "file:../client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "file:../client/ui-tool",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
