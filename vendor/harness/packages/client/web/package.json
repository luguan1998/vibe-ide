{
  "name": "@deepseek-ai/dsh-client-web",
  "description": "Web shell kernel: bootWebShell (module system holding + seed table + two-stage boot + AppRoot gate + app-shell assembly entry), consumed by the apps/web vite entry",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-client-modules": "file:modules",
    "@deepseek-ai/dsh-client-schema-form": "file:schema-form",
    "@deepseek-ai/dsh-client-ui-attachment": "file:ui-attachment",
    "@deepseek-ai/dsh-client-ui-primitives": "file:ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "file:ui-slots",
    "@deepseek-ai/dsh-client-ui-theme": "file:ui-theme",
    "@deepseek-ai/dsh-client-web-react": "file:web-react",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-client-runtime": "file:runtime",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ]
}
