{
  "name": "@deepseek-ai/dsh-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-settings-general"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-settings": "file:../settings/settings",
    "@deepseek-ai/schemastery": "file:../../vendor/schemastery",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "file:../api/remotes",
    "@deepseek-ai/dsh-client-connection": "file:connection",
    "@deepseek-ai/dsh-client-locale": "file:locale",
    "@deepseek-ai/dsh-client-runtime": "file:runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "file:ui-primitives",
    "@deepseek-ai/dsh-client-ui-settings": "file:ui-settings",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "file:ui-slots",
    "@deepseek-ai/dsh-client-web-react": "file:web-react",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "file:../api/remotes",
    "@deepseek-ai/dsh-client-connection": "file:connection",
    "@deepseek-ai/dsh-client-locale": "file:locale",
    "@deepseek-ai/dsh-client-runtime": "file:runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "file:ui-primitives",
    "@deepseek-ai/dsh-client-ui-settings": "file:ui-settings",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "file:ui-slots",
    "@deepseek-ai/dsh-client-web-react": "file:web-react",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/cordis": "file:../../vendor/cordis",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
