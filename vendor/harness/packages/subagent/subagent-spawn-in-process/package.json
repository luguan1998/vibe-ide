    "@deepseek-ai/dsh-bash-local": "file:../shell/bash-local",
    "@deepseek-ai/dsh-subprocess-local": "file:../subprocess/subprocess-local",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-llm-deepseek": "file:../llm/llm-deepseek",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-subagent": "file:subagent",
    "@deepseek-ai/dsh-subagent-in-process-driver": "file:subagent-in-process-driver",
    "@deepseek-ai/dsh-tool-bash": "file:../shell/tool-bash",
    "@deepseek-ai/dsh-tool-subagent": "file:tool-subagent",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
