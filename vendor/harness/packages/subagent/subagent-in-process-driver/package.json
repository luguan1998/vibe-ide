{
  "name": "@deepseek-ai/dsh-subagent-in-process-driver",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-in-process-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-subagent": "file:subagent",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "file:../../vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../core/agent-loop",
    "@deepseek-ai/dsh-agent-presets": "file:../preset/agent-presets",
    "@deepseek-ai/dsh-fs-sandbox": "file:../fs/fs-sandbox",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-sandbox-policy": "file:../sandbox/sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-subagent": "file:subagent",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tool-fs": "file:../fs/tool-fs",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/dsh-user-approval": "file:../interaction/user-approval",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
