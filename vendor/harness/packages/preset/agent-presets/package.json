{
  "name": "@deepseek-ai/dsh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-include": "file:../../vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-atomic-write": "file:../util/atomic-write",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-home-paths": "file:../util/home-paths",
    "@deepseek-ai/dsh-scope": "file:../core/scope",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-settings": "file:../settings/settings",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@deepseek-ai/schemastery": "file:../../vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "file:../../vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../core/agent-loop",
    "@deepseek-ai/dsh-atomic-write": "file:../util/atomic-write",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-home-paths": "file:../util/home-paths",
    "@deepseek-ai/dsh-scope": "file:../core/scope",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-settings": "file:../settings/settings",
    "@deepseek-ai/dsh-settings-file": "file:../settings/settings-file",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
