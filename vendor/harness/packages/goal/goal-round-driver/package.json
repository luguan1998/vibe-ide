{
  "name": "@deepseek-ai/dsh-goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-goal": "file:goal",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../core/agent-loop",
    "@deepseek-ai/dsh-goal": "file:goal",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
