{
  "name": "@deepseek-ai/dsh-plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/plan/plan-mode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-commands": "file:../interaction/commands",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-session-projection": "file:../session/session-projection",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/dsh-user-questions": "file:../interaction/user-questions",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../core/agent-loop",
    "@deepseek-ai/dsh-code-runtime": "file:../code-runtime/code-runtime",
    "@deepseek-ai/dsh-commands": "file:../interaction/commands",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/dsh-session-projection": "file:../session/session-projection",
    "@deepseek-ai/dsh-system-prompt": "file:../core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../core/tools",
    "@deepseek-ai/dsh-user-questions": "file:../interaction/user-questions",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
