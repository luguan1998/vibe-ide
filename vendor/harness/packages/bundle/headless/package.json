{
  "name": "@deepseek-ai/dsh-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "file:../boot/cmdline",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "file:../code-runtime/code-runtime-worker-thread",
    "@deepseek-ai/schemastery": "file:../../vendor/schemastery",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-default-model": "file:../core/agent-default-model",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "file:../../vendor/loader",
    "@deepseek-ai/dsh-agent": "file:../core/agent",
    "@deepseek-ai/dsh-agent-default-model": "file:../core/agent-default-model",
    "@deepseek-ai/dsh-invariants": "file:../runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "file:../llm/llm",
    "@deepseek-ai/dsh-session": "file:../core/session",
    "@deepseek-ai/cordis": "file:../../vendor/cordis"
  }
}
